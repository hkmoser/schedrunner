{
  "type": "screen",
  "style": { "background": "$bg" },
  "children": [
    {
      "type": "scroll",
      "children": [
        {
          "type": "vstack",
          "style": { "spacing": 16, "padding": 16 },
          "children": [
            {
              "type": "hstack",
              "style": { "align": "center" },
              "children": [
                { "type": "text", "binding": "housing.title", "style": { "font": "largeTitle", "weight": "bold", "color": "$textPrimary" } },
                { "type": "spacer" },
                { "type": "text", "binding": "meta.updatedAtFormatted", "style": { "font": "caption", "color": "$textSecondary" }, "action": { "type": "refresh" } }
              ]
            },
            { "type": "text", "binding": "housing.subtitleFormatted", "style": { "font": "caption", "color": "$textSecondary" } },

            { "type": "text", "binding": "housing.newLabel", "style": { "font": "caption", "weight": "bold", "color": "$textSecondary" } },
            {
              "type": "vstack",
              "props": { "repeat": "housing.newProperties" },
              "style": { "spacing": 12 },
              "children": [
                { "type": "propertyCard", "binding": "item" }
              ]
            },

            { "type": "text", "binding": "housing.highLabel", "style": { "font": "caption", "weight": "bold", "color": "$accent" } },
            {
              "type": "vstack",
              "props": { "repeat": "housing.highProperties" },
              "style": { "spacing": 12 },
              "children": [
                { "type": "propertyCard", "binding": "item" }
              ]
            },

            { "type": "text", "binding": "housing.mediumLabel", "style": { "font": "caption", "weight": "bold", "color": "$textSecondary" } },
            {
              "type": "vstack",
              "props": { "repeat": "housing.mediumProperties" },
              "style": { "spacing": 12 },
              "children": [
                { "type": "propertyCard", "binding": "item" }
              ]
            },

            { "type": "text", "binding": "housing.lowLabel", "style": { "font": "caption", "weight": "bold", "color": "$textSecondary" } },
            {
              "type": "vstack",
              "props": { "repeat": "housing.lowProperties" },
              "style": { "spacing": 12 },
              "children": [
                { "type": "propertyCard", "binding": "item" }
              ]
            },

            {
              "type": "card",
              "style": { "background": "$cardBg", "cornerRadius": 20, "padding": 16 },
              "children": [
                { "type": "text", "props": { "text": "Showings" }, "style": { "font": "subhead", "weight": "semibold", "color": "$textSecondary" } },
                { "type": "text", "binding": "housing.showingsEmptyFormatted", "style": { "font": "caption", "color": "$textSecondary", "align": "center" } },
                {
                  "type": "vstack",
                  "props": { "repeat": "housing.showings" },
                  "style": { "spacing": 0 },
                  "children": [
                    {
                      "type": "hstack",
                      "style": { "align": "center", "spacing": 12 },
                      "children": [
                        {
                          "type": "vstack",
                          "style": { "spacing": 2 },
                          "children": [
                            { "type": "text", "binding": "item.showingAtFormatted", "style": { "font": "caption", "weight": "semibold", "color": "$accent" } },
                            { "type": "text", "binding": "item.address", "style": { "font": "body", "weight": "semibold", "color": "$textPrimary" } },
                            { "type": "text", "binding": "item.addressLine2", "style": { "font": "caption", "color": "$textSecondary" } },
                            { "type": "text", "binding": "item.contact", "style": { "font": "caption", "color": "$textSecondary" } }
                          ]
                        },
                        { "type": "spacer" },
                        { "type": "text", "props": { "text": "Maps ↗" }, "style": { "font": "caption", "color": "$accent" }, "action": { "type": "openURL", "urlBinding": "item.mapsUrl" } }
                      ]
                    },
                    { "type": "divider", "style": { "color": "$divider" } }
                  ]
                }
              ]
            },

            {
              "type": "disclosure",
              "props": { "text": "Passed properties", "open": false },
              "children": [
                {
                  "type": "vstack",
                  "props": { "repeat": "housing.passedProperties" },
                  "style": { "spacing": 12 },
                  "children": [
                    { "type": "propertyCard", "binding": "item" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
