+++ b/test_session_hold.py
@@ -0,0 +1,205 @@
+#!/usr/bin/env python3
+"""
+Tests for afm_session_hold — the dead-session hold that stops afm_live_daemon
+from re-calling Apple's auth endpoint on every launchd restart.
+
+Run:  python3 test_session_hold.py
+
+Deliberately imports only afm_session_hold (stdlib-only), so this suite runs
+without pyicloud / pandas / BigQuery credentials.
+"""
+
+import os
+import tempfile
+import time
+import unittest
+
+from afm_session_hold import SessionHold
+
+RESTART_INTERVAL = 300  # launchd ThrottleInterval in com.joemoser.afm-daemon.plist
+
+
+class HoldTestCase(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.cookie_dir = os.path.join(self.tmp.name, "pyicloud")
+        os.mkdir(self.cookie_dir)
+        self._write_session("original-token")
+        self.hold = SessionHold(
+            state_path=os.path.join(self.tmp.name, "session-dead"),
+            cookie_dir=self.cookie_dir,
+        )
+
+    def tearDown(self):
+        self.tmp.cleanup()
+
+    def _write_session(self, token):
+        """Stand in for ~/.pyicloud/<md5>.session."""
+        with open(os.path.join(self.cookie_dir, "abc123.session"), "w") as f:
+            f.write(token)
+
+    def _reauth(self):
+        """Stand in for util/auth.sh installing a freshly minted session."""
+        self._write_session("brand-new-token-from-auth-sh")
+
+
+class TestRestartStorm(HoldTestCase):
+    """The bug: a dead session + KeepAlive restarts = one failed /accountLogin
+    every 5 minutes, forever."""
+
+    def _apple_calls_over(self, seconds, enter_hold):
+        """Simulate launchd restarting the daemon every ThrottleInterval with a
+        session Apple keeps rejecting. Returns how many restarts actually reached
+        Apple's auth endpoint."""
+        calls = 0
+        for now in range(0, seconds, RESTART_INTERVAL):
+            if self.hold.wait_secs(now=now) > 0:
+                continue  # daemon short-circuits: no network call
+            calls += 1  # build_api() -> /accountLogin -> rejected
+            if enter_hold:
+                self.hold.enter(now=now)
+        return calls
+
+    def test_unheld_dead_session_hammers_apple_every_restart(self):
+        """Baseline — this is the behavior in the logs (12 auth attempts/hour)."""
+        self.assertEqual(self._apple_calls_over(3600, enter_hold=False), 12)
+
+    def test_hold_throttles_the_storm_to_a_few_probes(self):
+        """With the hold, an hour of restarts costs 3 auth attempts, not 12."""
+        # t=0 rejected (hold, 15m) / t=900 probe rejected (30m) / t=2700 probe.
+        self.assertEqual(self._apple_calls_over(3600, enter_hold=True), 3)
+
+    def test_hold_converges_to_hourly_over_a_day(self):
+        """Long outage: ~24 probes/day instead of ~288."""
+        calls = self._apple_calls_over(24 * 3600, enter_hold=True)
+        self.assertLessEqual(calls, 26)
+        self.assertGreaterEqual(calls, 20)
+
+
+class TestHoldLifecycle(HoldTestCase):
+    def test_no_state_means_no_hold(self):
+        self.assertEqual(self.hold.wait_secs(), 0.0)
+
+    def test_enter_blocks_the_next_restart(self):
+        self.hold.enter(now=1000)
+        self.assertEqual(self.hold.wait_secs(now=1000 + RESTART_INTERVAL), 600.0)
+
+    def test_probe_becomes_due_after_the_delay(self):
+        self.hold.enter(now=1000)
+        self.assertEqual(self.hold.wait_secs(now=1000 + 900), 0.0)
+
+    def test_delay_escalates_then_caps(self):
+        self.assertEqual(self.hold.next_probe_secs(1), 900.0)
+        self.assertEqual(self.hold.next_probe_secs(2), 1800.0)
+        self.assertEqual(self.hold.next_probe_secs(3), 3600.0)
+        self.assertEqual(self.hold.next_probe_secs(9), 3600.0)
+
+    def test_repeated_rejections_escalate_the_wait(self):
+        self.hold.enter(now=0)
+        self.hold.enter(now=900)
+        self.assertEqual(self.hold.wait_secs(now=900), 1800.0)
+
+    def test_clear_releases_the_hold(self):
+        self.hold.enter(now=0)
+        self.hold.clear()
+        self.assertEqual(self.hold.wait_secs(now=0), 0.0)
+
+    def test_clear_is_idempotent(self):
+        self.hold.clear()
+        self.hold.clear()  # must not raise when there is no state file
+
+    def test_held_since_records_first_rejection(self):
+        self.hold.enter(now=500)
+        self.hold.enter(now=1400)
+        self.assertEqual(self.hold.held_since(), 500.0)
+        self.assertIsNone(SessionHold(
+            state_path=os.path.join(self.tmp.name, "absent"),
+            cookie_dir=self.cookie_dir).held_since())
+
+
+class TestSelfClearingOnReauth(HoldTestCase):
+    """auth.sh must be the only recovery step — no manual state cleanup."""
+
+    def test_reauth_clears_the_hold_immediately(self):
+        self.hold.enter(now=0)
+        self.assertGreater(self.hold.wait_secs(now=60), 0)
+        self._reauth()
+        self.assertEqual(self.hold.wait_secs(now=60), 0.0)
+
+    def test_reauth_removes_the_state_file(self):
+        self.hold.enter(now=0)
+        self._reauth()
+        self.hold.wait_secs(now=60)
+        self.assertFalse(os.path.exists(self.hold.state_path))
+
+    def test_reauth_resets_the_escalation(self):
+        """A new session that also dies starts at 15 min, not the old backoff."""
+        for t in (0, 900, 2700):
+            self.hold.enter(now=t)
+        self._reauth()
+        state = self.hold.enter(now=3000)
+        self.assertEqual(state["probes"], 1)
+        self.assertEqual(self.hold.wait_secs(now=3000), 900.0)
+
+    def test_fingerprint_tracks_session_content(self):
+        before = self.hold.fingerprint()
+        self._reauth()
+        self.assertNotEqual(before, self.hold.fingerprint())
+
+    def test_fingerprint_is_stable_when_nothing_changes(self):
+        self.assertEqual(self.hold.fingerprint(), self.hold.fingerprint())
+
+    def test_added_session_file_changes_the_fingerprint(self):
+        before = self.hold.fingerprint()
+        with open(os.path.join(self.cookie_dir, "abc123.cookiejar"), "w") as f:
+            f.write("cookies")
+        self.assertNotEqual(before, self.hold.fingerprint())
+
+
+class TestFailsOpen(HoldTestCase):
+    """A bug in the hold must never keep a working session offline."""
+
+    def test_corrupt_state_file_does_not_hold(self):
+        with open(self.hold.state_path, "w") as f:
+            f.write("{not json")
+        self.assertEqual(self.hold.wait_secs(), 0.0)
+
+    def test_non_dict_state_file_does_not_hold(self):
+        with open(self.hold.state_path, "w") as f:
+            f.write('"just a string"')
+        self.assertEqual(self.hold.wait_secs(), 0.0)
+
+    def test_garbage_fields_do_not_hold(self):
+        self.hold.enter(now=0)
+        state = self.hold._read()
+        state["last_probe"] = "not-a-number"
+        self.hold._write(state)
+        self.assertEqual(self.hold.wait_secs(now=0), 0.0)
+
+    def test_missing_cookie_dir_still_fingerprints(self):
+        hold = SessionHold(state_path=self.hold.state_path,
+                           cookie_dir=os.path.join(self.tmp.name, "gone"))
+        self.assertIsInstance(hold.fingerprint(), str)
+        hold.enter(now=0)
+        self.assertEqual(hold.wait_secs(now=60), 840.0)  # 900s delay, 60s elapsed
+
+    def test_state_write_is_atomic(self):
+        """No temp files left behind, and the state file is always complete."""
+        self.hold.enter(now=0)
+        leftovers = [n for n in os.listdir(os.path.dirname(self.hold.state_path))
+                     if n.startswith(".afm-hold-")]
+        self.assertEqual(leftovers, [])
+        self.assertIsInstance(self.hold._read(), dict)
+
+    def test_default_paths_are_absolute(self):
+        hold = SessionHold()
+        self.assertTrue(os.path.isabs(hold.state_path))
+        self.assertTrue(os.path.isabs(hold.cookie_dir))
+
+    def test_wait_secs_defaults_to_wall_clock(self):
+        self.hold.enter(now=time.time())
+        self.assertGreater(self.hold.wait_secs(), 0)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
