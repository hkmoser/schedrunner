+#!/usr/bin/env python3
+"""
+Integration tests for afm_live_daemon's dead-session handling.
+
+Reproduces the failure in log/afm-daemon.log (2026-08-16 10:15–10:54): Apple
+returns 421, the daemon exits, launchd restarts it 5 min later, and it calls
+/accountLogin with the same dead token again — forever.
+
+Apple (pyicloud) and the data plane (afm_pipeline -> pandas/BigQuery) are the
+external services here, so they are stubbed; everything else — main(), the lock,
+the hold, the alert bookkeeping — is the real code under test.
+
+Run:  python3 test_daemon_hold.py
+"""
+
+import os
+import sys
+import tempfile
+import types
+import unittest
+import warnings
+
+# main() intentionally holds the lock file open for the process lifetime; calling
+# it in-process makes that show up as an unclosed-file warning. Not a leak.
+warnings.filterwarnings("ignore", category=ResourceWarning)
+
+
+def _install_stubs():
+    """Stand in for pyicloud + the BigQuery data plane so the daemon imports."""
+    requests_stub = types.ModuleType("requests")
+    requests_stub.post = lambda *a, **k: None
+    sys.modules["requests"] = requests_stub
+
+    exceptions = types.ModuleType("pyicloud.exceptions")
+
+    class PyiCloudException(Exception):
+        pass
+
+    class PyiCloudFailedLoginException(PyiCloudException):
+        pass
+
+    class PyiCloudAuthRequiredException(PyiCloudException):
+        pass
+
+    class PyiCloud2FARequiredException(PyiCloudException):
+        pass
+
+    class PyiCloudAPIResponseException(PyiCloudException):
+        def __init__(self, reason, code=None):
+            super().__init__(reason)
+            self.code = code
+
+    for cls in (PyiCloudException, PyiCloudFailedLoginException,
+                PyiCloudAuthRequiredException, PyiCloud2FARequiredException,
+                PyiCloudAPIResponseException):
+        setattr(exceptions, cls.__name__, cls)
+
+    pyicloud = types.ModuleType("pyicloud")
+    pyicloud.exceptions = exceptions
+    sys.modules["pyicloud"] = pyicloud
+    sys.modules["pyicloud.exceptions"] = exceptions
+
+    pipeline = types.ModuleType("afm_pipeline")
+    pipeline.COOKIE_DIR = "/nonexistent-until-a-test-sets-it"
+    pipeline.build_api = lambda: (_ for _ in ()).throw(AssertionError("unset"))
+    pipeline.install_accountlogin_logging = lambda api, log=None: None
+    pipeline.cleanup_old_csvs = lambda log=None: (0, 0)
+    pipeline.run_pipeline = lambda api, log=None: 0
+    pipeline.accountlogin_total = lambda: 0
+    pipeline.accountlogin_count_since = lambda secs: 0
+    sys.modules["afm_pipeline"] = pipeline
+    return exceptions, pipeline
+
+
+EXC, PIPELINE = _install_stubs()
+
+import afm_live_daemon as daemon  # noqa: E402 — must follow the stub install
+from afm_session_hold import SessionHold  # noqa: E402
+
+
+class DaemonTestCase(unittest.TestCase):
+    def setUp(self):
+        self.tmp = tempfile.TemporaryDirectory()
+        self.cookie_dir = os.path.join(self.tmp.name, "pyicloud")
+        os.mkdir(self.cookie_dir)
+        self._write_session("original-token")
+
+        PIPELINE.COOKIE_DIR = self.cookie_dir
+        daemon.HOLD = SessionHold(
+            state_path=os.path.join(self.tmp.name, "session-dead"),
+            cookie_dir=self.cookie_dir,
+        )
+        daemon.LOCK_PATH = os.path.join(self.tmp.name, "afm_live.lock")
+        daemon.DEAD_ALERT_FILE = os.path.join(self.tmp.name, "alert-last")
+        daemon.EXPIRY_WARN_FILE = os.path.join(self.tmp.name, "expiry-warned")
+        daemon._running = True
+
+        self.alerts = []
+        daemon.send_alert = lambda text: self.alerts.append(text)
+
+        self.build_calls = 0
+        self.addCleanup(self.tmp.cleanup)
+
+    def _write_session(self, token):
+        with open(os.path.join(self.cookie_dir, "abc123.session"), "w") as f:
+            f.write(token)
+
+    def _reauth(self):
+        """Stand in for util/auth.sh installing a new session."""
+        self._write_session("brand-new-token-from-auth-sh")
+
+    def _apple_rejects(self, exc):
+        def build_api():
+            self.build_calls += 1
+            raise exc
+        PIPELINE.build_api = build_api
+
+    def _apple_accepts(self):
+        def build_api():
+            self.build_calls += 1
+            return object()
+        PIPELINE.build_api = build_api
+
+    def _boot(self):
+        """One launchd start of the daemon that is expected to die. Returns the
+        exit code."""
+        daemon._running = True
+        with self.assertRaises(SystemExit) as cm:
+            daemon.main()
+        return cm.exception.code
+
+    def _boot_healthy(self):
+        """One launchd start expected to reach the collection loop and leave it
+        cleanly (the stubbed run_pipeline clears _running after one cycle)."""
+        daemon._running = True
+        daemon.main()
+
+    def _dead_session_error(self):
+        """The exact shape from the log: 421 wrapped in a failed-login."""
+        return EXC.PyiCloudFailedLoginException(
+            "Invalid authentication token.",
+            EXC.PyiCloudAPIResponseException(
+                "Authentication required for Account. (421)", code=421),
+        )
+
+
+class TestRestartStormIsStopped(DaemonTestCase):
+    def test_first_rejection_alerts_and_exits_nonzero(self):
+        self._apple_rejects(self._dead_session_error())
+        self.assertEqual(self._boot(), 1)
+        self.assertEqual(self.build_calls, 1)
+        self.assertTrue(any("auth.sh" in a for a in self.alerts))
+
+    def test_restart_after_rejection_does_not_contact_apple(self):
+        """THE REGRESSION: before the hold, every launchd restart re-called
+        /accountLogin with the token Apple had already rejected."""
+        self._apple_rejects(self._dead_session_error())
+        self._boot()
+        for _ in range(11):  # a full hour of ThrottleInterval=300 restarts
+            self.assertEqual(self._boot(), 1)
+        self.assertEqual(self.build_calls, 1)
+
+    def test_held_restart_does_not_take_the_lock(self):
+        """Short-circuiting must not touch /tmp/afm_live.lock — the cron
+        fallback's mutual exclusion stays exactly as it was."""
+        self._apple_rejects(self._dead_session_error())
+        self._boot()
+        os.remove(daemon.LOCK_PATH)
+        self._boot()
+        self.assertFalse(os.path.exists(daemon.LOCK_PATH))
+
+    def test_untrusted_session_also_holds(self):
+        self._apple_rejects(EXC.PyiCloud2FARequiredException("not trusted"))
+        self._boot()
+        self._boot()
+        self.assertEqual(self.build_calls, 1)
+        self.assertTrue(any("2FA" in a or "trust" in a for a in self.alerts))
+
+    def test_auth_required_also_holds(self):
+        self._apple_rejects(EXC.PyiCloudAuthRequiredException("450 at startup"))
+        self._boot()
+        self._boot()
+        self.assertEqual(self.build_calls, 1)
+
+
+class TestRecovery(DaemonTestCase):
+    def test_reauth_lets_the_next_restart_through(self):
+        self._apple_rejects(self._dead_session_error())
+        self._boot()
+        self._boot()
+        self.assertEqual(self.build_calls, 1)
+
+        self._reauth()
+        self._apple_accepts()
+        PIPELINE.run_pipeline = self._one_cycle_then_stop
+        self._boot_healthy()
+        self.assertEqual(self.build_calls, 2)
+
+    def test_successful_startup_clears_a_stale_hold(self):
+        daemon.HOLD.enter()
+        self._reauth()
+        self._apple_accepts()
+        PIPELINE.run_pipeline = self._one_cycle_then_stop
+        self._boot_healthy()
+        self.assertFalse(os.path.exists(daemon.HOLD.state_path))
+
+    def test_transient_startup_error_does_not_hold(self):
+        """A network blip must keep the 5-minute retry cadence — the hold is
+        only for sessions Apple has actually rejected."""
+        self._apple_rejects(EXC.PyiCloudAPIResponseException("gateway", code=503))
+        self._boot()
+        self._boot()
+        self.assertEqual(self.build_calls, 2)
+        self.assertFalse(os.path.exists(daemon.HOLD.state_path))
+
+    def _one_cycle_then_stop(self, api, log=None):
+        daemon._running = False
+        return 3
+
+
+class TestMidLoopDeath(DaemonTestCase):
+    def test_session_dying_mid_loop_holds_too(self):
+        self._apple_accepts()
+
+        def run_pipeline(api, log=None):
+            raise self._dead_session_error()
+
+        PIPELINE.run_pipeline = run_pipeline
+        self.assertEqual(self._boot(), 1)
+        self.assertTrue(os.path.exists(daemon.HOLD.state_path))
+
+        self._boot()  # the restart that follows must not re-auth
+        self.assertEqual(self.build_calls, 1)
+
+    def test_healthy_cycle_clears_the_hold(self):
+        daemon.HOLD.enter()
+        self._reauth()
+        self._apple_accepts()
+
+        def run_pipeline(api, log=None):
+            daemon._running = False
+            return 2
+
+        PIPELINE.run_pipeline = run_pipeline
+        self._boot_healthy()  # exits the loop cleanly, no SystemExit
+        self.assertFalse(os.path.exists(daemon.HOLD.state_path))
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
