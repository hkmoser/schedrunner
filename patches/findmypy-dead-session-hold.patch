+#!/usr/bin/env python3
+"""
+afm_session_hold.py — "the session is dead, stop calling Apple" state.
+
+WHY THIS EXISTS
+    afm_live_daemon runs under a KeepAlive LaunchAgent with ThrottleInterval=300.
+    When Apple declares the session dead (421 "Authentication required for
+    Account" -> PyiCloudFailedLoginException("Invalid authentication token.")),
+    the daemon alerts and exits(1) — and launchd restarts it 5 minutes later.
+    That restart calls /accountLogin again with the same dead token, fails
+    identically, and the cycle repeats forever: ~288 failed auth attempts a day.
+
+    That loop is worse than useless. Only util/auth.sh can mint a new session,
+    and repeated auth attempts are exactly what makes Apple rate-limit SRP and
+    refuse trust tokens for 24 h — so the crash loop actively sabotages the
+    auth.sh run that would fix it.
+
+    This module records the death on disk. While the hold is active the daemon
+    short-circuits at startup WITHOUT touching Apple, and probes only on a slow
+    escalating schedule (15 min -> 30 min -> 60 min, capped) in case Apple's
+    refusal was transient after all.
+
+SELF-CLEARING
+    The hold is stamped with a fingerprint of ~/.pyicloud. util/auth.sh installs
+    a brand-new session directory (atomic rename), so the fingerprint changes the
+    moment re-auth succeeds — the next launchd restart sees the mismatch, drops
+    the hold, and reconnects. Recovery stays hands-off: run auth.sh, done.
+
+FAIL OPEN
+    Every unreadable/corrupt/missing-state path resolves to "no hold" (0 s wait).
+    A bug in this file must never be able to keep a healthy session offline.
+
+Stdlib only — no pyicloud, pandas, or BigQuery imports — so it stays importable
+(and unit-testable) anywhere.
+"""
+
+import hashlib
+import json
+import os
+import tempfile
+import time
+
+DEFAULT_STATE_PATH = os.path.expanduser("~/.pyicloud-daemon-session-dead")
+DEFAULT_COOKIE_DIR = os.path.expanduser("~/.pyicloud")
+
+
+class SessionHold:
+    """On-disk record of 'Apple says this session is dead; stop hammering it'."""
+
+    # Delay before the 1st re-probe after the session is declared dead, doubling
+    # per failed probe up to the cap. 15 min is long enough to stop the storm,
+    # short enough that a genuinely transient refusal self-heals within the hour.
+    FIRST_PROBE_SECS = 900
+    MAX_PROBE_SECS = 3600
+
+    def __init__(self, state_path=DEFAULT_STATE_PATH, cookie_dir=DEFAULT_COOKIE_DIR):
+        self.state_path = state_path
+        self.cookie_dir = cookie_dir
+
+    # ── session identity ──────────────────────────────────────────────────────
+
+    def fingerprint(self):
+        """Cheap identity of the on-disk session: changes iff the session files
+        change (i.e. auth.sh installed a new one). Never raises — an unreadable
+        cookie dir just hashes to its own distinct value."""
+        try:
+            parts = []
+            for entry in sorted(os.scandir(self.cookie_dir), key=lambda e: e.name):
+                if not entry.is_file():
+                    continue
+                st = entry.stat()
+                parts.append(f"{entry.name}:{st.st_size}:{st.st_mtime_ns}")
+            blob = "|".join(parts)
+        except Exception as exc:
+            blob = f"unreadable:{type(exc).__name__}"
+        return hashlib.sha256(blob.encode()).hexdigest()
+
+    # ── state file ────────────────────────────────────────────────────────────
+
+    def _read(self):
+        try:
+            with open(self.state_path) as f:
+                state = json.load(f)
+            return state if isinstance(state, dict) else None
+        except Exception:
+            return None  # missing or corrupt -> fail open, no hold
+
+    def _write(self, state):
+        """Write atomically: a launchd restart mid-write must never read a
+        half-written state file (which would fail open and resume hammering)."""
+        try:
+            d = os.path.dirname(self.state_path) or "."
+            fd, tmp = tempfile.mkstemp(dir=d, prefix=".afm-hold-")
+            try:
+                with os.fdopen(fd, "w") as f:
+                    json.dump(state, f)
+                os.replace(tmp, self.state_path)
+            except Exception:
+                try:
+                    os.unlink(tmp)
+                except OSError:
+                    pass
+                raise
+        except Exception:
+            pass  # never let bookkeeping break the daemon
+
+    def clear(self):
+        """Drop the hold — the session is healthy again."""
+        try:
+            os.remove(self.state_path)
+        except FileNotFoundError:
+            pass
+        except Exception:
+            pass
+
+    # ── the two calls the daemon makes ────────────────────────────────────────
+
+    def enter(self, now=None):
+        """Record that Apple just rejected this session. Escalates the probe
+        delay if the SAME session has already been rejected before; a different
+        session on disk starts the escalation over. Returns the new state."""
+        now = time.time() if now is None else now
+        fp = self.fingerprint()
+        state = self._read() or {}
+        if state.get("fingerprint") != fp:
+            state = {"since": now}
+        state["fingerprint"] = fp
+        state["probes"] = int(state.get("probes", 0)) + 1
+        state["last_probe"] = now
+        state.setdefault("since", now)
+        self._write(state)
+        return state
+
+    def next_probe_secs(self, probes):
+        """Delay after `probes` consecutive rejections: 15m, 30m, 60m, 60m…"""
+        if probes < 1:
+            return 0.0
+        return float(min(self.FIRST_PROBE_SECS * (2 ** (probes - 1)),
+                         self.MAX_PROBE_SECS))
+
+    def wait_secs(self, now=None):
+        """Seconds the daemon must wait before contacting Apple again.
+
+        0.0 means "go ahead and authenticate" — either there is no hold, the
+        session on disk has changed (auth.sh ran), or the next probe is due.
+        Clears the hold when the session changed, so recovery needs no manual
+        cleanup."""
+        now = time.time() if now is None else now
+        state = self._read()
+        if not state:
+            return 0.0
+        if state.get("fingerprint") != self.fingerprint():
+            self.clear()  # auth.sh installed a new session — hold is obsolete
+            return 0.0
+        try:
+            probes = int(state.get("probes", 0))
+            last_probe = float(state.get("last_probe", 0))
+        except (TypeError, ValueError):
+            return 0.0  # corrupt fields -> fail open
+        due_at = last_probe + self.next_probe_secs(probes)
+        return max(0.0, due_at - now)
+
+    def held_since(self):
+        """Epoch seconds when this session was first declared dead, or None."""
+        state = self._read()
+        if not state:
+            return None
+        try:
+            return float(state["since"])
+        except (KeyError, TypeError, ValueError):
+            return None
